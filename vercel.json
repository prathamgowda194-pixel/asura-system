{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron_hunt",
      "schedule": "*/30 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/projects/studio/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/studio",
      "destination": "/projects/studio/index.html"
    },
    {
      "source": "/studio/",
      "destination": "/projects/studio/index.html"
    },
    {
      "source": "/projects/:slug/assets/:asset*",
      "destination": "/api/serve_project?slug=:slug&asset=:asset*"
    },
    {
      "source": "/projects/:slug/:asset(\\w+\\.\\w+)",
      "destination": "/api/serve_project?slug=:slug&asset=:asset"
    },
    {
      "source": "/assets/:asset*",
      "destination": "/api/serve_project?slug=aadriti-learning-centre&asset=:asset*"
    },
    {
      "source": "/drone-flight.mp4",
      "destination": "/api/serve_project?slug=villa-elysee&asset=drone-flight.mp4"
    },
    {
      "source": "/projects/:slug/admin.html",
      "destination": "/api/serve_project?slug=:slug&admin=true"
    },
    {
      "source": "/projects/:slug/admin",
      "destination": "/api/serve_project?slug=:slug&admin=true"
    },
    {
      "source": "/projects/:slug/index.html",
      "destination": "/api/serve_project?slug=:slug"
    },
    {
      "source": "/projects/:slug/",
      "destination": "/api/serve_project?slug=:slug"
    },
    {
      "source": "/projects/:slug",
      "destination": "/api/serve_project?slug=:slug"
    }
  ]
}