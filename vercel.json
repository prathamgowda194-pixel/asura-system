{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron_hunt",
      "schedule": "*/30 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/projects/studio/index.html",
      "permanent": false
    },
    {
      "source": "/studio",
      "destination": "/projects/studio/index.html",
      "permanent": false
    },
    {
      "source": "/projects/villa-elysee/",
      "destination": "/projects/villa-elysee",
      "permanent": false
    },
    {
      "source": "/projects/aadriti-learning-centre/",
      "destination": "/projects/aadriti-learning-centre",
      "permanent": false
    },
    {
      "source": "/projects/pixnova/",
      "destination": "/projects/pixnova",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/projects/:slug/assets/:match*",
      "destination": "/api/serve_project?slug=:slug&asset=:match*"
    },
    {
      "source": "/projects/villa-elysee/drone-flight.mp4",
      "destination": "/api/serve_asset?path=drone-flight.mp4"
    },
    {
      "source": "/drone-flight.mp4",
      "destination": "/api/serve_asset?path=drone-flight.mp4"
    },
    {
      "source": "/assets/:match*",
      "destination": "/api/serve_asset?path=assets/:match*"
    },
    {
      "source": "/projects/:slug/admin.html",
      "destination": "/api/serve_project?slug=:slug&admin=true"
    },
    {
      "source": "/projects/:slug/admin",
      "destination": "/api/serve_project?slug=:slug&admin=true"
    },
    {
      "source": "/projects/:slug/index.html",
      "destination": "/api/serve_project?slug=:slug"
    },
    {
      "source": "/projects/:slug/",
      "destination": "/api/serve_project?slug=:slug"
    },
    {
      "source": "/projects/:slug",
      "destination": "/api/serve_project?slug=:slug"
    }
  ]
}