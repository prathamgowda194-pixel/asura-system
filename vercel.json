{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron_hunt",
      "schedule": "*/30 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/projects/studio/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/studio",
      "destination": "/projects/studio/index.html"
    },
    {
      "source": "/studio/",
      "destination": "/projects/studio/index.html"
    },
    {
      "source": "/projects/nuve-skincare",
      "destination": "/projects/nuve-skincare/index.html"
    },
    {
      "source": "/projects/nuve-skincare/",
      "destination": "/projects/nuve-skincare/index.html"
    },
    {
      "source": "/projects/nuve-skincare/assets/:asset*",
      "destination": "/projects/nuve-skincare/assets/:asset*"
    },
    {
      "source": "/projects/nuve-skincare/hero_character_loop.mp4",
      "destination": "/api/serve_project?slug=nuve-skincare&asset=hero_character_loop.mp4"
    },
    {
      "source": "/projects/nuve-skincare/section2_cream_loop.mp4",
      "destination": "/api/serve_project?slug=nuve-skincare&asset=section2_cream_loop.mp4"
