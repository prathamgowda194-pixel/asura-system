{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron_hunt",
      "schedule": "*/30 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/projects/studio/index.html",
      "permanent": false
    },
    {
      "source": "/studio",
      "destination": "/projects/studio/index.html",
      "permanent": false
    },
    {
      "source": "/projects/kage/",
      "destination": "/projects/kage",
      "permanent": false
    },
    {
      "source": "/kage",
      "destination": "/projects/kage",
      "permanent": false
    },
    {
      "source": "/landing-pages/kage.html",
      "destination": "/projects/kage",
      "permanent": false
    },
    {
      "source": "/projects/mustang/",
      "destination": "/projects/mustang",
      "permanent": false
    },
    {
      "source": "/mustang",
      "destination": "/projects/mustang",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/projects/mustang/assets/:match*",
      "destination": "/api/serve_asset?path=projects/mustang/assets/:match*"
    },
    {
      "source": "/projects/:slug/assets/:match*",
      "destination": "/api/serve_asset?path=projects/:slug/assets/:match*"
    },
    {
      "source": "/projects/assets/:match*",
      "destination": "/api/serve_asset?path=projects/mustang/assets/:match*"
    },
    {
      "source": "/projects/mustang-fastback-1968/assets/:match*",
      "destination": "/api/serve_asset?path=projects/mustang/assets/:match*"
    },
    {
      "source": "/landing-pages/assets/:match*",
      "destination": "/api/serve_asset?path=projects/mustang/assets/:match*"
    },
    {
      "source": "/assets/:match*",
      "destination": "/api/serve_asset?path=projects/mustang/assets/:match*"
    },
    {
      "source": "/projects/kage/secret-pathways-assets/:match*",
      "destination": "/api/serve_asset?path=projects/kage/secret-pathways-assets/:match*"
    },
    {
      "source": "/projects/secret-pathways-assets/:match*",
      "destination": "/api/serve_project?slug=kage&asset=:match*"
    },
    {
      "source": "/secret-pathways-assets/:match*",
      "destination": "/api/serve_project?slug=kage&asset=:match*"
    },
    {
      "source": "/projects/:slug/admin.html",
      "destination": "/api/serve_project?slug=:slug&admin=true"
    },
    {
      "source": "/projects/:slug/admin",
      "destination": "/api/serve_project?slug=:slug&admin=true"
    },
    {
      "source": "/projects/:slug/index.html",
      "destination": "/api/serve_project?slug=:slug"
    },
    {
      "source": "/projects/:slug/",
      "destination": "/api/serve_project?slug=:slug"
    },
    {
      "source": "/projects/:slug",
      "destination": "/api/serve_project?slug=:slug"
    }
  ]
}