{
  "mcpServers": {
    "web3d-mcp-server": {
      "command": "node",
      "args": ["C:\\Users\\WINDOWS\\Desktop\\manus-builder\\mcp-servers\\web3d-mcp-server\\dist\\server.js"]
    },
    "shadcn-ui": {
      "command": "npx",
      "args": ["-y", "shadcn-ui-mcp-server"]
    },
    "21st-dev-magic": {
      "command": "npx",
      "args": ["-y", "@21st-dev/magic-mcp"]
    },
    "framer-motion": {
      "command": "npx",
      "args": ["-y", "@orkait-ai/motion-dev-react-mcp"]
    },
    "gsap": {
      "command": "npx",
      "args": ["-y", "bruzethegreat-gsap-master-mcp-server@latest"]
    },
    "blender-hunyuan-3d": {
      "command": "npx",
      "args": ["-y", "blender-mcp-hunyuan"],
      "env": {
        "HUNYUAN_API_KEY": "YOUR_HUNYUAN_API_KEY",
        "BLENDER_PATH": "C:\\Program Files\\Blender Foundation\\Blender\\blender.exe"
      }
    }
  }
