{
  "mcpServers": {
    "shadcn-ui": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@latest",
        "mcp"
      ],
      "description": "Official Shadcn UI component registry search, preview, and extraction server."
    },
    "magic-mcp-21st": {
      "command": "npx",
      "args": [
        "-y",
        "@21st-dev/magic-mcp"
      ],
      "env": {
        "API_KEY": "public_preview"
      },
      "description": "21st.dev Magic MCP: AI component generator, animated Tailwind blocks, and SVGL brand assets."
    }
  },
  "modelConfigurations": {
    "gemini-3.6-flash": {
      "provider": "google",
      "functionCalling": true,
      "toolMode": "auto",
      "temperature": 0.2
    },
    "openai-form": {
      "provider": "openai",
      "responseFormat": {
        "type": "json_object"
      },
      "temperature": 0.2
    }
  }
}