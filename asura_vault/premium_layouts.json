{
  "version": "1.0.0",
  "source": "21st.dev Trends + NexusIO UI/UX Pro Max",
  "layouts": {
    "luxury-hero-cinematic": {
      "name": "Luxury Cinematic Hero",
      "features": ["Video/WebGL canvas backdrop", "Radial gradient illumination", "Noise grain overlay", "Typography text-mask reveal", "Dual action CTAs"],
      "markupPattern": "<section class=\"relative min-h-[90vh] flex flex-col items-center justify-center text-center px-6 pt-24 pb-16 overflow-hidden\">\n  <div class=\"absolute inset-0 -z-10 bg-radial from-slate-900/60 via-black to-[#06080B]\"></div>\n  <div class=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-amber-500/30 bg-amber-950/40 text-xs font-mono text-amber-300 mb-8\">\n    <span class=\"w-2 h-2 rounded-full bg-amber-400 animate-ping\"></span>\n    <span>{{BADGE_TEXT}}</span>\n  </div>\n  <h1 class=\"text-4xl sm:text-7xl font-serif-luxury font-bold text-white tracking-tight max-w-5xl leading-[1.08] text-reveal-line\">\n    {{HEADLINE_HTML}}\n  </h1>\n  <p class=\"text-base sm:text-lg text-zinc-400 max-w-2xl font-normal leading-relaxed mt-6\">\n    {{SUBTITLE_TEXT}}\n  </p>\n  <div class=\"flex flex-wrap items-center justify-center gap-4 mt-8 font-mono text-xs\">\n    <a href=\"#inquire\" class=\"px-8 py-4 rounded-xl bg-gradient-to-r from-amber-500 to-yellow-400 text-black font-extrabold shadow-xl hover:from-amber-400 hover:to-yellow-300 transition active:scale-95\">{{PRIMARY_CTA}} &rarr;</a>\n    <a href=\"#details\" class=\"px-8 py-4 rounded-xl bg-white/5 hover:bg-white/10 text-white border border-white/10 font-bold transition\">{{SECONDARY_CTA}}</a>\n  </div>\n</section>"
    },
    "asymmetric-bento-grid": {
      "name": "21st.dev Asymmetrical Bento Grid",
      "features": ["12-column staggered spans", "Glassmorphic elevation", "Border highlights on hover", "Micro-metric callouts"],
      "markupPattern": "<section class=\"max-w-7xl mx-auto px-6 py-20\">\n  <div class=\"grid grid-cols-1 md:grid-cols-12 gap-6 stagger-container\">\n    <div class=\"stagger-item md:col-span-8 p-8 sm:p-10 rounded-3xl border border-white/10 bg-slate-950/70 backdrop-blur-2xl space-y-4 hover:border-amber-500/40 transition\">\n      <div class=\"text-xs font-mono font-bold text-amber-400 uppercase\">{{CARD1_TAG}}</div>\n      <h3 class=\"text-2xl font-bold font-serif-luxury text-white\">{{CARD1_TITLE}}</h3>\n      <p class=\"text-xs sm:text-sm text-zinc-400 leading-relaxed\">{{CARD1_DESC}}</p>\n    </div>\n    <div class=\"stagger-item md:col-span-4 p-8 rounded-3xl border border-white/10 bg-slate-950/70 backdrop-blur-2xl flex flex-col justify-between hover:border-amber-500/40 transition\">\n      <div class=\"text-xs font-mono font-bold text-amber-400 uppercase\">{{CARD2_TAG}}</div>\n      <div>\n        <div class=\"text-4xl sm:text-5xl font-serif-luxury font-bold text-white\">{{CARD2_STAT}}</div>\n        <p class=\"text-xs text-zinc-400 font-mono mt-1\">{{CARD2_LABEL}}</p>\n      </div>\n    </div>\n  </div>\n</section>"
    },
    "luxury-product-showcase": {
      "name": "Luxury Product Showcase with PBR Reflections",
      "features": ["Interactive WebGL 3D canvas viewport", "Orbit mouse rotation", "Telemetry HUD", "Customizer swatches"],
      "markupPattern": "<section class=\"max-w-7xl mx-auto px-6 py-16 text-center\">\n  <div class=\"w-full h-[520px] rounded-3xl border border-white/10 bg-gradient-to-b from-slate-950/80 to-black relative overflow-hidden shadow-2xl scale-showcase\">\n    <canvas id=\"productCanvas\" class=\"w-full h-full cursor-grab active:cursor-grabbing\"></canvas>\n    <div class=\"absolute bottom-6 left-1/2 -translate-x-1/2 bg-black/80 backdrop-blur-md px-5 py-3 rounded-2xl border border-white/10 flex items-center space-x-4 z-20 font-mono text-xs\">\n      <span class=\"text-zinc-400 text-[11px] font-bold\">EDITION:</span>\n      {{SWATCH_BUTTONS}}\n    </div>\n  </div>\n</section>"
    },
    "editorial-curated-menu": {
      "name": "Editorial Curated Repertoire / Menu",
      "features": ["Numbered item indexes", "Price tags", "Ingredient specifications", "Direct selection trigger"],
      "markupPattern": "<div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 stagger-container\">\n  {{MENU_CARDS}}\n</div>"
    },
    "vip-reservation-concierge": {
      "name": "VIP Concierge & Allocation Terminal",
      "features": ["Form field validation", "High-ticket lead capture", "Instant digital voucher pass", "Confirmation feedback"],
      "markupPattern": "<section id=\"inquire\" class=\"max-w-3xl mx-auto px-6 py-20\">\n  <div class=\"p-8 sm:p-12 rounded-3xl border border-white/10 bg-slate-950/80 backdrop-blur-2xl space-y-6 shadow-2xl\">\n    <div class=\"text-center space-y-2\">\n      <span class=\"text-xs font-mono font-bold text-amber-400 uppercase tracking-widest\">// VIP CONCIERGE ALLOCATION</span>\n      <h2 class=\"text-2xl sm:text-4xl font-bold font-serif-luxury text-white\">{{FORM_TITLE}}</h2>\n      <p class=\"text-xs text-zinc-400 font-mono\">{{FORM_SUBTITLE}}</p>\n    </div>\n    <form onsubmit=\"handleVipSubmit(event)\" class=\"space-y-4 font-mono text-xs\">\n      {{FORM_FIELDS}}\n      <button type=\"submit\" id=\"vipSubmitBtn\" class=\"w-full py-4 rounded-xl bg-gradient-to-r from-amber-500 via-amber-400 to-yellow-300 text-black font-extrabold text-sm uppercase tracking-wider transition shadow-xl active:scale-98\">\n        {{SUBMIT_BUTTON_TEXT}} &rarr;\n      </button>\n    </form>\n  </div>\n</section>"
    }
  }
}
